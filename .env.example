APP_NAME="HeavyPack Admin"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8001
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=heavypack_admin
DB_USERNAME=heavypack_admin
DB_PASSWORD=

CATALOG_DB_HOST=127.0.0.1
CATALOG_DB_PORT=3306
CATALOG_DB_DATABASE=heavypack
CATALOG_DB_USERNAME=heavypack_content
CATALOG_DB_PASSWORD=

SESSION_DRIVER=file
SESSION_COOKIE=heavypack_admin_session
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=legacy
MAIL_MAILER=log

HEAVYPACK_SOURCE_DATABASE=heavypack
HEAVYPACK_ENVIRONMENT_LABEL="Katalog bersama — website lokal"
HEAVYPACK_CONTENT_MODE=shared
HEAVYPACK_WEBSITE_ROOT=C:/xampp/htdocs/public_html
HEAVYPACK_WEBSITE_URL=http://localhost/public_html
LEGACY_MEDIA_ROOT=C:/xampp/htdocs/public_html
LEGACY_MEDIA_URL=http://localhost/public_html

